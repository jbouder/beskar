          "html": {
            "@apply font-sans": {},
            "color-scheme": "light"
          },
          "html.dark": {
            "color-scheme": "dark"
          },
          "body": {
            "@apply bg-background text-foreground": {}
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
