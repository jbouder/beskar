        ":root": {
          "--duration-fast": "100ms",
          "--duration-base": "200ms",
          "--duration-slow": "350ms",
          "--ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
          "--ease-emphasized": "cubic-bezier(0.2, 0, 0, 1)"
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
