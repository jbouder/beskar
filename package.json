{
  "name": "@beskar/design",
  "version": "0.1.0",
  "private": true,
  "description": "Beskar design system. A shadcn component registry for vibe projects.",
  "homepage": "https://github.com/jbouder/beskar",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build:registry": "shadcn build --output public/r",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:write": "biome format --write",
    "ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "test:storybook": "vitest run --project=storybook",
    "build:storybook": "storybook build -o public",
    "build:pages": "bun run build:storybook && bun run build:registry",
    "sync:theme": "bun run scripts/sync-theme.ts && biome format --write registry.json",
    "deploy": "bun run build:pages && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oxanium": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "playwright": "1.65.0",
    "postcss": "8.5.23",
    "shadcn": "4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
